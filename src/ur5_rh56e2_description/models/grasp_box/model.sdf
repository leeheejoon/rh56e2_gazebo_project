<?xml version="1.0"?>
<sdf version="1.9">

  <model name="grasp_box">

    <!-- 움직일 수 있는 물체 -->
    <static>false</static>

    <link name="box_link">

      <!-- 질량 -->
      <inertial>
        <mass>0.1</mass>

        <inertia>
          <ixx>0.00006</ixx>
          <iyy>0.00006</iyy>
          <izz>0.00006</izz>

          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- 실제 충돌 계산에 사용되는 모양 -->
      <collision name="collision">
        <geometry>
          <box>
            <size>0.06 0.06 0.06</size>
          </box>
      
  </geometry>
      </collision>

      <!-- 화면에 보이는 모양 -->
      <visual name="visual">
        <geometry>
          <box>
            <size>0.06 0.06 0.06</size>
          </box>
        </geometry>

        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
        </material>
      </visual>

    </link>

  </model>

</sdf>
