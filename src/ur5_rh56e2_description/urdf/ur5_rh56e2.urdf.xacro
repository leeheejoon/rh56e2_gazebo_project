<?xml version="1.0"?>

<robot
  xmlns:xacro="http://wiki.ros.org/xacro"
  name="ur5_rh56e2">

  <!-- ===================================== -->
  <!-- UR5                                   -->
  <!-- ===================================== -->

  <xacro:include
    filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <xacro:arg name="ur_type" default="ur5"/>

  <xacro:arg
    name="joint_limit_params"
    default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>

  <xacro:arg
    name="kinematics_params"
    default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>

  <xacro:arg
    name="physical_params"
    default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>

  <xacro:arg
    name="visual_params"
    default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>

  <link name="world"/>

  <xacro:ur_robot
    name="ur5"
    tf_prefix="ur5_"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="false"
    force_abs_paths="true">

    <origin xyz="0 0 0"
            rpy="0 0 0"/>

  </xacro:ur_robot>

  <!-- ===================================== -->
  <!-- UR5 ros2_control for Gazebo           -->
  <!-- ===================================== -->

  <ros2_control name="ur5_sim_system" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="ur5_shoulder_pan_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="ur5_shoulder_lift_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-0.51145</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="ur5_elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.50894</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="ur5_wrist_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="ur5_wrist_2_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="ur5_wrist_3_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">1.53058</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

  </ros2_control>

  <!-- ===================================== -->
  <!-- 완성형 RH56E2                         -->
  <!-- ===================================== -->

  <xacro:include
    filename="$(find inspire_description)/xacro/ros2_control/hand.xacro"/>


  <!-- ===================================== -->
  <!-- UR5 ↔ RH56E2                         -->
  <!-- ===================================== -->

  <joint name="ur5_to_rh56e2" type="fixed">

    <parent link="ur5_flange"/>

    <child link="flange"/> <!-- RH56E2의 flange -->

    <origin xyz="0 0 0"
            rpy="0 0 0"/>

  </joint>

</robot>